&mmuart0 {
	status = "okay";
	current-speed = <921600>;
};

&mmuart1 {
	status = "okay";
	current-speed = <921600>;
};

&mmuart2 {
	status = "okay";
	current-speed = <921600>;
};

&mmuart3 {
	status = "okay";
	current-speed = <921600>;
};

/*
&mmuart4 {
	status = "disabled";
};
*/

/*
&pcie {
	status = "disabled";
};
*/

&qspi {
	status = "okay";
  flash@0 {
    compatible = "spi-nand";
    reg = <0>;
    spi-max-frequency = <12500000>;
    spi-tx-bus-width = <4>;
    spi-rx-bus-width = <4>;

    partitions {
      compatible = "fixed-partitions";
      #address-cells = <1>;
      #size-cells = <1>;

      partition@0 {
        label = "payload_a";
        reg = <0 0x00200000>;
      };
      partition@200000 {
        label = "ubi_a";
        reg = <0x00200000 0x07700000>;
      };
    };
  };
};

&fabric_qspi0 {
	status = "okay";
	num-cs = <1>;

	flash1: flash@1 {
		compatible = "spi-nand";
		reg = <0x0>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <12500000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "payload_b";
				reg = <0 0x00200000>;
			};
			partition@200000 {
				label = "ubi_b";
				reg = <0x00200000 0x07700000>;
			};
		};
	};
};

&fabric_raw_nand0 {
	status = "okay";
};

&fabric_raw_nand1 {
	status = "okay";
};

&refclk {
	clock-frequency = <100000000>;
};

/*
&refclk_ccc {
	clock-frequency = <50000000>;
};
*/

&rtc {
	status = "okay";
};

