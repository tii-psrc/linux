	phy-mode = "sgmii";
	phy-handle = <&phy9>;

	phy9: ethernet-phy@9 {
		reg = <9>;
	};

	phy8: ethernet-phy@8 {
		reg = <8>;
	};
};
*/


&mbox {
	status = "okay";
};

